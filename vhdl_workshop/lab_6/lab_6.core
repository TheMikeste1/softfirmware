CAPI=2:
# yaml-language-server: $schema=../../fusesoc_schema.json
# <https://fusesoc.readthedocs.io/en/stable/user/build_system/core_files.html>
name: personal:vhdl_workshop:lab_5:0.0.0
description: "Lab 6 from VHDL workshop. <https://www.vhdl-online.de/vhdl_workshop/lab_6>"

filesets:
  src:
    files:
      - exp_ff.vhd
      - p_display.vhd
    file_type: vhdlSource-2008
  test:
    files:
      - tb_exp_ff.vhd
    file_type: vhdlSource-2008

targets:
  default: &default
    filesets:
      - src
    default_tool: ghdl
    tools:
      ghdl:
        analyze_options: [--warn-reserved, --warn-unused]

  test:
    <<: *default
    filesets_append:
      - test
    toplevel: tb_exp_ff
    tools:
      ghdl:
        run_options: [--wave=wave.ghw]
