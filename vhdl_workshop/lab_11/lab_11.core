CAPI=2:
# yaml-language-server: $schema=../../fusesoc_schema.json
# <https://fusesoc.readthedocs.io/en/stable/user/build_system/core_files.html>
name: personal:vhdl_workshop:lab_11:0.0.0
description: "Lab 11 from VHDL workshop. <https://www.vhdl-online.de/vhdl_workshop/lab_11>"

filesets:
  src:
    files:
      - camera.vhd
      - decoder_case.vhd
      - decoder_if.vhd
      - disp_ctrl.vhd
      - disp_drv.vhd
      - exp_ctrl.vhd
      - exp_ff.vhd
      - fusesoc.conf
      - justfile
      - lab_11.core
      - main_ctrl.vhd
      - motor_timer.vhd
      - p_display.vhd
    file_type: vhdlSource-2008
  test:
    files:
      - tb_camera.vhd
    file_type: vhdlSource-2008

targets:
  default: &default
    filesets:
      - src
    default_tool: ghdl
    tools:
      ghdl:
        analyze_options: [--warn-reserved, --warn-unused]

  test:
    <<: *default
    filesets_append:
      - test
    toplevel: tb_camera
    tools:
      ghdl:
        run_options: [--wave=wave.ghw]
